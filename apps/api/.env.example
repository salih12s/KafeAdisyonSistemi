# Bu dosya şablondur. Kopyalayın: apps/api/.env
# GERÇEK PAROLA ASLA COMMIT EDİLMEZ. .env dosyası .gitignore içindedir.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/CafeAdisyon?schema=public

# --- İsteğe bağlı (varsayılanlarıyla çalışır) ---
# HOST: geliştirmede 127.0.0.1, üretimde 0.0.0.0 varsayılır.
# HOST=127.0.0.1
# LOG_LEVEL=info          # debug | info | warn | error
# JSON_BODY_LIMIT=1mb

# CORS_ORIGIN: YALNIZ arayüz API'den ayrı barındırılıyorsa doldurulur (ADR-020).
# Aynı origin kurulumunda boş bırakın; boşken CORS tamamen kapalıdır ve oturum
# çerezi SameSite=Strict kalır. Doldurulduğunda çerez SameSite=None; Secure olur
# ve HTTPS zorunlu hâle gelir. Virgülle ayrılır, sonda eğik çizgi olmaz.
# CORS_ORIGIN=https://alanadiniz.com,https://www.alanadiniz.com
