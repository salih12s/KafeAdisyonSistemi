# Bu dosya şablondur. Kopyalayın: apps/api/.env
# GERÇEK PAROLA ASLA COMMIT EDİLMEZ. .env dosyası .gitignore içindedir.

# development | test | production
NODE_ENV=development

# API sunucusunun portu. Üretimde web arayüzü de bu porttan sunulur.
PORT=3000

# 0.0.0.0 = yerel ağdaki telefon ve tabletler kasa bilgisayarına bağlanabilir.
# Yalnızca kasa bilgisayarından erişim isteniyorsa 127.0.0.1 yazın.
HOST=0.0.0.0

# CHANGE_ME yerine kendi PostgreSQL parolanızı yazın.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/CafeAdisyon"

# debug | info | warn | error
LOG_LEVEL=info

# JSON istek gövdesi üst sınırı
JSON_BODY_LIMIT=1mb
