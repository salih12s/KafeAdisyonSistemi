# Bu dosya şablondur. Kopyalayın: apps/api/.env
# GERÇEK PAROLA ASLA COMMIT EDİLMEZ. .env dosyası .gitignore içindedir.

NODE_ENV=development
PORT=3000
# MySQL/MariaDB (ADR-026). Parolada @ : / # ? varsa URL kodlanır.
# Hostinger'da host her zaman 127.0.0.1'dir (docs/HOSTINGER_DEPLOY.md).
DATABASE_URL=mysql://kafe:CHANGE_ME@127.0.0.1:3306/kafe_adisyon
# Yalnız `prisma migrate dev` için; ayrı ve boş bir veritabanı.
# SHADOW_DATABASE_URL=mysql://kafe:CHANGE_ME@127.0.0.1:3306/kafe_adisyon_shadow

# --- İsteğe bağlı (varsayılanlarıyla çalışır) ---
# HOST: geliştirmede 127.0.0.1, üretimde 0.0.0.0 varsayılır.
# HOST=127.0.0.1
# LOG_LEVEL=info          # debug | info | warn | error
# JSON_BODY_LIMIT=1mb

# DEMO_MODE: canlı demo (ADR-026). Giriş ekranında "Demo ile gir", demo hesap
# kilidi ve günlük veri yenilemesi. Yalnız adı "demo" içeren veritabanıyla açılır;
# veri her gün SİLİNİP yeniden üretilir. Gerçek işletmede asla açılmaz.
# DEMO_MODE=false

# CORS_ORIGIN: YALNIZ arayüz API'den ayrı barındırılıyorsa doldurulur (ADR-020).
# Aynı origin kurulumunda boş bırakın; boşken CORS tamamen kapalıdır ve oturum
# çerezi SameSite=Strict kalır. Doldurulduğunda çerez SameSite=None; Secure olur
# ve HTTPS zorunlu hâle gelir. Virgülle ayrılır, sonda eğik çizgi olmaz.
# CORS_ORIGIN=https://alanadiniz.com,https://www.alanadiniz.com
