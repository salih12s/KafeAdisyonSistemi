# Test ortamı şablonu. Kopyalayın: apps/api/.env.test
# Phase 0 testleri veritabanına bağlanmaz; bu dosya ileriki Phase'ler için hazırdır.

NODE_ENV=test
PORT=3001
HOST=127.0.0.1

# CHANGE_ME yerine kendi PostgreSQL parolanızı yazın.
# Üretim veritabanını test için kullanmayın; ileride ayrı bir test veritabanı tanımlanacaktır.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/CafeAdisyon"

LOG_LEVEL=error
JSON_BODY_LIMIT=1mb
