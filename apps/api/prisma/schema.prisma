// Kafe Adisyon Sistemi — Prisma şeması (MySQL/MariaDB)
//
// Phase 1: kimlik, işletme, salon, masa ve audit altyapısı.
// Phase 2: kategori, ürün, ürün seçenek grupları ve seçenek değerleri.
// Phase 3: masa adisyonları, sipariş kalemleri ve seçenek snapshot'ları.
// Phase 4: istasyon snapshot'ı ve hazırlık durumu akışı.
// Phase 8: kasa oturumları ve basit stok (reçete + hareket defteri).
//
// Kurallar:
// - Para alanları her zaman tam sayı kuruş (Int) olarak tutulur, Float kullanılmaz.
// - Zaman alanları UTC saklanır, arayüzde Europe/Istanbul'a çevrilir.
// - Domain kayıtları fiziksel olarak silinmez; ileride iptal/pasif alanları kullanılır.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
}

// MySQL/MariaDB (Hostinger, ADR-026). Bağlantı adresi CLI için prisma.config.ts,
// uygulama için lib/database.ts içindeki MariaDB adapter'ından gelir.
datasource db {
  provider = "mysql"
}

enum UserRole {
  OWNER
  CASHIER
  WAITER
  KITCHEN
}

model User {
  id                  String          @id @default(uuid()) @db.VarChar(36)
  fullName            String
  username            String          @unique
  passwordHash        String
  role                UserRole
  isActive            Boolean         @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  sessions            Session[]
  auditLogs           AuditLog[]
  openedChecks        Check[]         @relation("CheckOpenedBy")
  closedChecks        Check[]         @relation("CheckClosedBy")
  receivedPayments    Payment[]       @relation("PaymentReceivedBy")
  createdOrderItems   OrderItem[]     @relation("OrderItemCreatedBy")
  cancelledOrderItems OrderItem[]     @relation("OrderItemCancelledBy")
  complimentaryItems  OrderItem[]     @relation("OrderItemComplimentaryBy")
  appliedDiscounts    CheckDiscount[]
  accountEntries      AccountEntry[]
  openedCashSessions  CashSession[]   @relation("CashSessionOpenedBy")
  closedCashSessions  CashSession[]   @relation("CashSessionClosedBy")
  cashMovements       CashMovement[]
  stockMovements      StockMovement[]

  @@index([role, isActive])
}

model Session {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BusinessSettings {
  id           String   @id @default("business")
  businessName String
  phone        String?
  address      String? @db.VarChar(500)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DiningArea {
  id        String      @id @default(uuid()) @db.VarChar(36)
  name      String
  nameKey   String      @unique
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tables    CafeTable[]

  @@index([isActive, sortOrder])
}

model CafeTable {
  id        String     @id @default(uuid()) @db.VarChar(36)
  areaId    String     @db.VarChar(36)
  name      String
  nameKey   String
  capacity  Int?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  area      DiningArea @relation(fields: [areaId], references: [id], onDelete: Restrict)
  checks    Check[]

  @@unique([areaId, nameKey])
  @@index([areaId, isActive, sortOrder])
}

enum PreparationArea {
  KITCHEN
  BAR
}

enum OptionSelectionType {
  SINGLE
  MULTIPLE
}

model Category {
  id        String    @id @default(uuid()) @db.VarChar(36)
  name      String
  // nameKey: tr-TR küçük harfe indirgenmiş ad; aynı isim tekrarını engeller.
  nameKey   String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id              String               @id @default(uuid()) @db.VarChar(36)
  categoryId      String               @db.VarChar(36)
  name            String
  nameKey         String
  // Fiyat her zaman tam sayı kuruş; Float kullanılmaz.
  priceKurus      Int
  preparationArea PreparationArea
  sortOrder       Int                  @default(0)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups    ProductOptionGroup[]
  orderItems      OrderItem[]
  stockUsages     ProductStockUsage[]

  @@unique([categoryId, nameKey])
  @@index([categoryId, isActive, sortOrder])
}

model ProductOptionGroup {
  id               String               @id @default(uuid()) @db.VarChar(36)
  productId        String               @db.VarChar(36)
  name             String
  nameKey          String
  selectionType    OptionSelectionType
  isRequired       Boolean              @default(false)
  sortOrder        Int                  @default(0)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  product          Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  values           ProductOptionValue[]
  orderItemOptions OrderItemOption[]

  @@unique([productId, nameKey])
  @@index([productId, isActive, sortOrder])
}

model ProductOptionValue {
  id               String             @id @default(uuid()) @db.VarChar(36)
  groupId          String             @db.VarChar(36)
  name             String
  nameKey          String
  // Ürün fiyatına eklenen fark; indirim için negatif olabilir.
  priceDeltaKurus  Int                @default(0)
  sortOrder        Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  group            ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  orderItemOptions OrderItemOption[]

  @@unique([groupId, nameKey])
  @@index([groupId, isActive, sortOrder])
}

enum CheckStatus {
  OPEN
  CANCELLED
  PAID
  MERGED
}

enum PaymentMethod {
  CASH
  CARD
  ACCOUNT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum AccountEntryType {
  DEBT
  COLLECTION
  REFUND
  CORRECTION
}

enum OrderItemStatus {
  SENT
  PREPARING
  READY
  SERVED
}

model Check {
  id                String          @id @default(uuid()) @db.VarChar(36)
  tableId           String          @db.VarChar(36)
  openedByUserId    String          @db.VarChar(36)
  guestCount        Int
  status            CheckStatus     @default(OPEN)
  openedAt          DateTime        @default(now())
  closedAt          DateTime?
  closedByUserId    String?         @db.VarChar(36)
  mergedIntoCheckId String?         @db.VarChar(36)
  totalKurus        Int             @default(0)
  updatedAt         DateTime        @updatedAt
  // MySQL'de kısmi unique index yoktur. "Masa başına tek açık adisyon" kuralı bu
  // generated kolonla korunur: status OPEN iken tableId, değilse NULL (unique
  // index birden çok NULL'a izin verir). Değeri veritabanı hesaplar; uygulama yazmaz.
  openTableKey      String?         @unique(map: "Check_one_open_per_table_key") @db.VarChar(36)
  table             CafeTable       @relation(fields: [tableId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  openedBy          User            @relation("CheckOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy          User?           @relation("CheckClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payments          Payment[]
  discounts         CheckDiscount[]
  accountEntries    AccountEntry[]
  mergedInto        Check?          @relation("CheckMerge", fields: [mergedIntoCheckId], references: [id], onDelete: Restrict)
  mergedSources     Check[]         @relation("CheckMerge")
  stockMovements    StockMovement[]

  @@index([tableId, status])
  @@index([status, openedAt])
}

model Payment {
  id               String        @id @default(uuid()) @db.VarChar(36)
  checkId          String        @db.VarChar(36)
  method           PaymentMethod
  amountKurus      Int
  receivedByUserId String        @db.VarChar(36)
  createdAt        DateTime      @default(now())
  check            Check         @relation(fields: [checkId], references: [id], onDelete: Restrict)
  receivedBy       User          @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: Restrict)

  @@index([checkId, createdAt])
  @@index([receivedByUserId, createdAt])
}

model CheckDiscount {
  id              String       @id @default(uuid()) @db.VarChar(36)
  checkId         String       @db.VarChar(36)
  type            DiscountType
  value           Int
  amountKurus     Int
  reason          String @db.VarChar(500)
  appliedByUserId String       @db.VarChar(36)
  createdAt       DateTime     @default(now())
  check           Check        @relation(fields: [checkId], references: [id], onDelete: Restrict)
  appliedBy       User         @relation(fields: [appliedByUserId], references: [id], onDelete: Restrict)

  @@index([checkId, createdAt])
}

model Customer {
  id        String         @id @default(uuid()) @db.VarChar(36)
  name      String
  phone     String? @db.VarChar(500)
  note      String? @db.VarChar(500)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  entries   AccountEntry[]

  @@index([isActive, name])
}

model AccountEntry {
  id          String           @id @default(uuid()) @db.VarChar(36)
  customerId  String           @db.VarChar(36)
  type        AccountEntryType
  amountKurus Int
  description String @db.VarChar(500)
  checkId     String?          @db.VarChar(36)
  actorUserId String           @db.VarChar(36)
  createdAt   DateTime         @default(now())
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  check       Check?           @relation(fields: [checkId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([checkId])
}

model OrderItem {
  id                      String            @id @default(uuid()) @db.VarChar(36)
  checkId                 String            @db.VarChar(36)
  productId               String            @db.VarChar(36)
  productNameSnapshot     String
  categoryIdSnapshot      String            @db.VarChar(36)
  categoryNameSnapshot    String
  unitPriceKurusSnapshot  Int
  preparationAreaSnapshot PreparationArea
  preparationStatus       OrderItemStatus   @default(SENT)
  quantity                Int
  note                    String? @db.VarChar(500)
  lineTotalKurus          Int
  createdByUserId         String            @db.VarChar(36)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  cancellationReason      String? @db.VarChar(500)
  cancelledByUserId       String?           @db.VarChar(36)
  cancelledAt             DateTime?
  complimentaryReason     String? @db.VarChar(500)
  complimentaryByUserId   String?           @db.VarChar(36)
  complimentaryAt         DateTime?
  check                   Check             @relation(fields: [checkId], references: [id], onDelete: Restrict)
  product                 Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy               User              @relation("OrderItemCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy             User?             @relation("OrderItemCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  complimentaryBy         User?             @relation("OrderItemComplimentaryBy", fields: [complimentaryByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  options                 OrderItemOption[]

  @@index([checkId, createdAt])
  @@index([preparationAreaSnapshot, preparationStatus, createdAt], map: "OrderItem_preparationAreaSnapshot_preparationStatus_create_idx")
  @@index([productId])
}

model OrderItemOption {
  id                      String             @id @default(uuid()) @db.VarChar(36)
  orderItemId             String             @db.VarChar(36)
  optionGroupId           String             @db.VarChar(36)
  optionValueId           String             @db.VarChar(36)
  groupNameSnapshot       String
  valueNameSnapshot       String
  priceDeltaKurusSnapshot Int
  orderItem               OrderItem          @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  optionGroup             ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Restrict)
  optionValue             ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, optionValueId])
  @@index([optionGroupId])
  @@index([optionValueId])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.VarChar(36)
  actorUserId String   @db.VarChar(36)
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

// Kasa oturumu (vardiya). Beklenen nakit saklanmaz, ödemelerden türetilir;
// yalnız kapanışta sayılan ve beklenen tutar o anın kaydı olarak yazılır.
// Aynı anda tek OPEN oturum `openKey` generated kolonunun unique index'iyle korunur.
model CashSession {
  id                String            @id @default(uuid()) @db.VarChar(36)
  status            CashSessionStatus @default(OPEN)
  openedByUserId    String            @db.VarChar(36)
  openedAt          DateTime          @default(now())
  openingCashKurus  Int
  openingNote       String? @db.VarChar(500)
  closedByUserId    String?           @db.VarChar(36)
  closedAt          DateTime?
  countedCashKurus  Int?
  expectedCashKurus Int?
  closingNote       String? @db.VarChar(500)
  // Aynı anda tek OPEN oturum: status OPEN iken 'OPEN', değilse NULL (generated
  // kolon, bkz. Check.openTableKey). Uygulama yazmaz.
  openKey           String?           @unique(map: "CashSession_one_open_key") @db.VarChar(4)
  openedBy          User              @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy          User?             @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  movements         CashMovement[]

  @@index([status, openedAt])
}

// Satış dışı nakit hareketi (bozuk para ekleme, masraf ödeme). Değiştirilmez.
model CashMovement {
  id          String           @id @default(uuid()) @db.VarChar(36)
  sessionId   String           @db.VarChar(36)
  type        CashMovementType
  amountKurus Int
  reason      String @db.VarChar(500)
  actorUserId String           @db.VarChar(36)
  createdAt   DateTime         @default(now())
  session     CashSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  actor       User             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt])
}

enum StockUnit {
  PIECE
  GRAM
  MILLILITER
}

enum StockMovementType {
  PURCHASE
  SALE
  WASTE
  ADJUSTMENT
}

// Miktarlar en küçük birimde tam sayıdır. Bakiye mutable kolon değildir;
// StockMovement hareketlerinin toplamından türetilir (cari ile aynı ilke).
model StockItem {
  id                String              @id @default(uuid()) @db.VarChar(36)
  name              String
  nameKey           String              @unique
  unit              StockUnit
  lowStockThreshold Int                 @default(0)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  usages            ProductStockUsage[]
  movements         StockMovement[]

  @@index([isActive, name])
}

// Reçete satırı: bir adet ürün satıldığında düşülecek miktar. Satır silinmez,
// reçeteden çıkarıldığında pasife alınır.
model ProductStockUsage {
  id              String    @id @default(uuid()) @db.VarChar(36)
  productId       String    @db.VarChar(36)
  stockItemId     String    @db.VarChar(36)
  quantityPerUnit Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockItem       StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([productId, stockItemId])
  @@index([stockItemId])
}

model StockMovement {
  id            String            @id @default(uuid()) @db.VarChar(36)
  stockItemId   String            @db.VarChar(36)
  type          StockMovementType
  quantityDelta Int
  reason        String? @db.VarChar(500)
  checkId       String?           @db.VarChar(36)
  actorUserId   String            @db.VarChar(36)
  createdAt     DateTime          @default(now())
  stockItem     StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  check         Check?            @relation(fields: [checkId], references: [id], onDelete: Restrict)
  actor         User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([stockItemId, createdAt])
  @@index([checkId])
}
