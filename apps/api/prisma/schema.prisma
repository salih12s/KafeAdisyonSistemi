// Kafe Adisyon Sistemi — Prisma şeması
//
// Phase 1: kimlik, işletme, salon, masa ve audit altyapısı.
// Phase 2: kategori, ürün, ürün seçenek grupları ve seçenek değerleri.
// Adisyon, sipariş, ödeme ve cari modelleri sonraki Phase'lere aittir.
//
// Kurallar:
// - Para alanları her zaman tam sayı kuruş (Int) olarak tutulur, Float kullanılmaz.
// - Zaman alanları UTC saklanır, arayüzde Europe/Istanbul'a çevrilir.
// - Domain kayıtları fiziksel olarak silinmez; ileride iptal/pasif alanları kullanılır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CASHIER
  WAITER
  KITCHEN
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  username     String     @unique
  passwordHash String
  role         UserRole
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([role, isActive])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BusinessSettings {
  id           String   @id @default("business")
  businessName String
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DiningArea {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  nameKey   String      @unique
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tables    CafeTable[]

  @@index([isActive, sortOrder])
}

model CafeTable {
  id        String     @id @default(uuid()) @db.Uuid
  areaId    String     @db.Uuid
  name      String
  nameKey   String
  capacity  Int?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  area      DiningArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([areaId, nameKey])
  @@index([areaId, isActive, sortOrder])
}

enum PreparationArea {
  KITCHEN
  BAR
}

enum OptionSelectionType {
  SINGLE
  MULTIPLE
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  // nameKey: tr-TR küçük harfe indirgenmiş ad; aynı isim tekrarını engeller.
  nameKey   String    @unique
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id              String               @id @default(uuid()) @db.Uuid
  categoryId      String               @db.Uuid
  name            String
  nameKey         String
  // Fiyat her zaman tam sayı kuruş; Float kullanılmaz.
  priceKurus      Int
  preparationArea PreparationArea
  sortOrder       Int                  @default(0)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  category        Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups    ProductOptionGroup[]

  @@unique([categoryId, nameKey])
  @@index([categoryId, isActive, sortOrder])
}

model ProductOptionGroup {
  id            String               @id @default(uuid()) @db.Uuid
  productId     String               @db.Uuid
  name          String
  nameKey       String
  selectionType OptionSelectionType
  isRequired    Boolean              @default(false)
  sortOrder     Int                  @default(0)
  isActive      Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  product       Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  values        ProductOptionValue[]

  @@unique([productId, nameKey])
  @@index([productId, isActive, sortOrder])
}

model ProductOptionValue {
  id              String             @id @default(uuid()) @db.Uuid
  groupId         String             @db.Uuid
  name            String
  nameKey         String
  // Ürün fiyatına eklenen fark; indirim için negatif olabilir.
  priceDeltaKurus Int                @default(0)
  sortOrder       Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  group           ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([groupId, nameKey])
  @@index([groupId, isActive, sortOrder])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
