// Kafe Adisyon Sistemi — Prisma şeması
//
// Phase 1 yalnız kimlik, işletme, salon, masa ve audit altyapısını içerir.
// Ürün, adisyon, sipariş, ödeme ve cari modelleri sonraki Phase'lere aittir.
//
// Kurallar:
// - Para alanları her zaman tam sayı kuruş (Int) olarak tutulur, Float kullanılmaz.
// - Zaman alanları UTC saklanır, arayüzde Europe/Istanbul'a çevrilir.
// - Domain kayıtları fiziksel olarak silinmez; ileride iptal/pasif alanları kullanılır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  CASHIER
  WAITER
  KITCHEN
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String
  username     String     @unique
  passwordHash String
  role         UserRole
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]

  @@index([role, isActive])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BusinessSettings {
  id           String   @id @default("business")
  businessName String
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DiningArea {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  nameKey   String      @unique
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tables    CafeTable[]

  @@index([isActive, sortOrder])
}

model CafeTable {
  id        String     @id @default(uuid()) @db.Uuid
  areaId    String     @db.Uuid
  name      String
  nameKey   String
  capacity  Int?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  area      DiningArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([areaId, nameKey])
  @@index([areaId, isActive, sortOrder])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
